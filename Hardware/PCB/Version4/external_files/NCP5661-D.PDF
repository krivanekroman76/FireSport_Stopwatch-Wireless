            xmlns:xmpMM="http://ns.adobe.com/xap/1.0/mm/">
         <xmp:CreatorTool>BroadVision, Inc.</xmp:CreatorTool>
         <xmp:ModifyDate>2024-09-04T13:28:48+02:00</xmp:ModifyDate>
         <xmp:CreateDate>2024-09-04T13:28:15+02:00</xmp:CreateDate>
         <xmp:MetadataDate>2024-09-04T13:28:48+02:00</xmp:MetadataDate>
         <dc:format>application/pdf</dc:format>
         <dc:title>
            <rdf:Alt>
               <rdf:li xml:lang="x-default">NCP5661 - Linear Regulator - Low Output Voltage, Ultra-Fast Low Dropout, Enable 1.0 A</rdf:li>
            </rdf:Alt>
         </dc:title>
         <dc:creator>
            <rdf:Seq>
               <rdf:li>onsemi</rdf:li>
            </rdf:Seq>
         </dc:creator>
         <dc:description>
            <rdf:Alt>
               <rdf:li xml:lang="x-default">The NCP5661/NCV5661 is a high performance, low dropout linear&#xA;regulator designed for high power applications that require up to 1.0 A&#xA;current. It is offered in both fixed and adjustable output versions. With&#xA;output voltages as low as 0.9 V and ultraâˆ’fast response times for load&#xA;transients, the NCP5661/NCV5661 also provides additional features&#xA;such as Enable and Error Flag (for the fixed output version),&#xA;increasing the utility of these devices. A thermally robust, 5 pin DPAK&#xA;or DFN 3x3.3 mm, combined with an architecture that offers low&#xA;ground current (independent of load), provides for a superior&#xA;highâˆ’current LDO solution.</rdf:li>
            </rdf:Alt>
         </dc:description>
         <pdf:Producer>Acrobat Distiller 24.0 (Windows)</pdf:Producer>
         <pdf:Keywords/>
         <xmpMM:DocumentID>uuid:4e309c8b-a802-4359-8c2d-6bf11c40b214</xmpMM:DocumentID>
         <xmpMM:InstanceID>uuid:80f64dca-e3c6-4bb4-ab33-a5995c9a08ce</xmpMM:InstanceID>
      </rdf:Description>
   </rdf:RDF>
